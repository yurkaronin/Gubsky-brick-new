{
  "name": "html-builder",
  "version": "1.0.0",
  "description": "HTML сборщик с Nunjucks",
  "scripts": {

    "start": "node tasks/start.js",
    "dev": "node tasks/start.js",
    "watch": "node tasks/watch.js",
    "clean": "node tasks/clean.js",
    "build": "node tasks/build.js",
    "build:prod": "cross-env NODE_ENV=production node tasks/build.js",
    "build:continue": "node tasks/build.js --continue",
    "build:prod:continue": "cross-env NODE_ENV=production node tasks/build.js --continue",
    "test:build": "npm run build && echo '✅ Development сборка завершена'",
    "test:prod": "npm run build:prod && echo '✅ Production сборка завершена'"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "fs-extra": "^11.1.1",
    "html-minifier-terser": "^7.2.0",
    "live-server": "^1.2.2",
    "nunjucks": "^3.2.4",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "html",
    "builder",
    "nunjucks",
    "static-site"
  ],
  "author": "Your Name",
  "license": "MIT"
}
